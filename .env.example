# HTTP bind address inside the container
ADDR=:8080

# Comma-separated browser origins allowed to open the WebSocket.
# Leave empty to allow the same origin only.
ALLOWED_ORIGINS=https://call.example.com

# JSON array passed to RTCPeerConnection in the browser.
# Replace with your own coturn credentials and hostname.
ICE_SERVERS_JSON=[{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"change-me","credential":"change-me"}]
